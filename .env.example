# KARDEUCE Content Hub — server settings (copy to .env:  cp .env.example .env)
#
# Everything here is read ONLY by the API server in /server. None of it is
# bundled into the browser app. Leave a platform's keys empty and the app
# shows realistic demo data for that platform instead.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port of the API server. The Vite dev server proxies /api/* to it.
PORT=8787

# Where the web app runs. After an OAuth login the API sends the browser back
# to  ${APP_URL}/#/settings
APP_URL=http://localhost:5173

# Public HTTPS address that Instagram/TikTok redirect to after login. OAuth
# needs https, so for local use run a tunnel to the API port (8787), e.g.
#   cloudflared tunnel --url http://localhost:8787
#   ngrok http 8787
# and put the https URL here (no trailing slash). Callback URLs become:
#   Instagram:        ${PUBLIC_URL}/api/auth/instagram/callback
#   TikTok Business:  ${PUBLIC_URL}/api/auth/tiktok/callback/   (note the trailing "/")
#   TikTok Display:   ${PUBLIC_URL}/api/auth/tiktok/callback
# Not needed if you only paste access tokens in Settings → Integrations.
PUBLIC_URL=

# ---------------------------------------------------------------------------
# Instagram — "Instagram API with Instagram Login" (no Facebook Page needed)
# Meta developer app → Instagram → API setup with Instagram login
# Permissions: instagram_business_basic, instagram_business_manage_insights
# ---------------------------------------------------------------------------

# "Instagram app ID" (NOT the Facebook App ID shown at the top of the dashboard).
IG_APP_ID=
# "Instagram app secret".
IG_APP_SECRET=
# Graph API version used for graph.instagram.com calls.
IG_GRAPH_VERSION=v26.0

# ---------------------------------------------------------------------------
# TikTok — option A (recommended): TikTok API for Business, Accounts API
# business-api.tiktok.com → My Apps. Requires the Accounts API access form.
# Scopes: user.info.basic, user.info.username, user.info.stats, user.insights,
#         video.list, video.insights
# When both A and B are filled in, A is used.
# ---------------------------------------------------------------------------

# App ID of your TikTok for Business developer app.
TIKTOK_BUSINESS_APP_ID=
# Secret of that app.
TIKTOK_BUSINESS_SECRET=
# "TikTok account holder authorization URL" copied from My Apps → your app.
# The server appends &state=… to it.
TIKTOK_BUSINESS_AUTH_URL=

# ---------------------------------------------------------------------------
# TikTok — option B (fallback): Display API / Login Kit (developers.tiktok.com)
# Only lifetime counts: followers, views, likes, comments, shares.
# Scopes: user.info.basic, user.info.profile, user.info.stats, video.list
# ---------------------------------------------------------------------------

# "Client key" of your TikTok for Developers app.
TIKTOK_CLIENT_KEY=
# "Client secret" of that app.
TIKTOK_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Connect via browser (no token, no developer app)
# Settings → Integrations → "Connect via browser" opens Chrome on this
# computer. Log in to TikTok (TikTok Studio) or Instagram + Meta Business
# Suite, then close the window. Logins are kept in server/.data/browser/.
# Reads the private web dashboards: pages can change, and automated access
# is against TikTok's and Meta's terms. Use your own accounts only.
# ---------------------------------------------------------------------------

# Hours between background syncs while the API server runs (min 1).
BROWSER_SYNC_HOURS=6
# Set to false to watch Chrome while it syncs (useful when something breaks).
BROWSER_HEADLESS=true
# Only needed if Chrome isn't in the default location.
CHROME_PATH=
# Set only if your username isn't detected automatically.
TIKTOK_USERNAME=
INSTAGRAM_USERNAME=
# true → saves the raw page data to server/.data/scrape-debug/ for tuning.
SCRAPE_DEBUG=false

# Hosted dashboard (e.g. Vercel): after each browser sync, commit the numbers
# to public/live-data.json on origin/main so the site shows real data.
# PUBLIC on a public repo: followers, daily numbers, posts and captions.
# Never tokens or logins. `npm run publish:data` publishes once by hand.
PUBLISH_LIVE_DATA=false
PUBLISH_REMOTE=origin
PUBLISH_BRANCH=main

# Shared content plan: the hosted site's address (e.g. https://your-app.vercel.app).
# Set it and the local app edits the same content plan as the website.
WORKSPACE_URL=
